{
    "name":  "little-strides",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1",
                    "build":  "vite build \u0026\u0026 node scripts/cache-manifest.mjs",
                    "preview":  "vite preview --host 127.0.0.1 --port 4197 --strictPort",
                    "test":  "node --test tests/engine.test.mjs tests/art.test.mjs tests/gameplay.test.mjs",
                    "test:mobile":  "playwright test",
                    "art:seed":  "node scripts/seed-art.mjs \u0026\u0026 node scripts/export-art.mjs --seed",
                    "art:export":  "node scripts/export-art.mjs",
                    "art:motion":  "node scripts/export-art.mjs --motion"
                },
    "dependencies":  {
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "phaser":  "^3.90.0"
                     },
    "devDependencies":  {
                            "vite":  "^7.1.12",
                            "@playwright/test":  "^1.56.1"
                        }
}
